{
  "info": {
    "_postman_id": "c24d8e09-10bf-4b79-b614-3053b807d78f",
    "name": "Raksha — Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All business APIs implemented in this repository. Import Raksha.local.postman_environment.json, select it, and set password locally using DEMO_PASSWORD in .env. Send Authentication / Login first. Session cookies are managed by Postman; keep its cookie jar enabled and use the same baseUrl hostname throughout. Before every mutation, a collection pre-request script obtains a fresh CSRF token. No real password or session is included in this export. Admin is needed for Rules, Audit and Recovery. Use requests individually: simulations create synthetic data, resolutions close cases, rules updates change future scoring. Optional recovery requires a real DEAD job. See postman/README.md for workflow and units."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
