{
  "title": "Raksha — Fraud Platform",
  "uid": "raksha-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions ingested (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(raksha_transactions_ingested_total[5m]) * 60", "legendFormat": "ingested/min" }
      ]
    },
    {
      "id": 2,
      "title": "Scoring latency (p95, seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(raksha_scoring_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95 latency" }
      ]
    },
    {
      "id": 3,
      "title": "Alerts created by classification",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(raksha_alerts_created_total[5m])) by (classification) * 60", "legendFormat": "{{classification}}/min" }
      ]
    },
    {
      "id": 4,
      "title": "Scoring jobs pending / dead",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "raksha_jobs_pending", "legendFormat": "pending" },
        { "expr": "raksha_jobs_dead", "legendFormat": "dead" }
      ]
    },
    {
      "id": 5,
      "title": "Job retries / dead-lettered (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(raksha_jobs_retried_total[5m]) * 60", "legendFormat": "retried/min" },
        { "expr": "rate(raksha_jobs_dead_lettered_total[5m]) * 60", "legendFormat": "dead-lettered/min" }
      ]
    },
    {
      "id": 6,
      "title": "Scoring exceptions by type (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(rate(raksha_scoring_exceptions_total[5m])) by (type) * 60", "legendFormat": "{{type}}/min" }
      ]
    }
  ]
}
