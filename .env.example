DATABASE_PASSWORD=replace-with-database-password
DEMO_PASSWORD=replace-with-login-password-min-10-characters
APP_PORT=8088
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
WORKER_ENABLED=true

# WORKER_MODE=poll (default) uses only the DB-poll worker; no RabbitMQ connection is attempted.
# WORKER_MODE=queue additionally consumes transactions.ingested via RabbitMQ, with the DB-poll
# worker still running as a safety net. See docs/plans/02-messaging-rabbitmq.md.
WORKER_MODE=poll
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Grafana dashboard admin password (see docs/observability/).
GRAFANA_PASSWORD=admin

# Optional Docker Hub image naming
DOCKERHUB_USERNAME=adarshbiradar
IMAGE_TAG=latest

# SMTP credentials stay on the server; never put them in React.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=adarshbiradar888@gmail.com
SMTP_PASSWORD=
SMTP_FROM=adarshbiradar888@gmail.com
