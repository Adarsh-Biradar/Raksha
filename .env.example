DATABASE_PASSWORD=replace-with-database-password
DEMO_PASSWORD=replace-with-login-password-min-10-characters
APP_PORT=8088
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
WORKER_ENABLED=true

# WORKER_MODE=poll (default) uses only the DB-poll worker; no RabbitMQ connection is attempted.
# WORKER_MODE=queue additionally consumes transactions.ingested via RabbitMQ, with the DB-poll
# worker still running as a safety net. See docs/plans/02-messaging-rabbitmq.md.
WORKER_MODE=poll
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Sessions and the API rate limiter live in Redis so both work correctly if the api service is
# scaled to multiple replicas. Set SESSION_STORE=none to roll back to single-replica in-memory
# sessions without a code change (see docs/plans/04-scalability.md).
SESSION_STORE=redis

# Grafana dashboard admin password (see docs/observability/).
GRAFANA_PASSWORD=admin

# Optional Docker Hub image naming
DOCKERHUB_USERNAME=adarshbiradar
IMAGE_TAG=latest

# SMTP credentials stay on the server; never put them in React.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=adarshbiradar888@gmail.com
SMTP_PASSWORD=
SMTP_FROM=adarshbiradar888@gmail.com

# Razorpay sandbox only. Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Azure OpenAI, used to turn ScoringEngine's deterministic rule output into an analyst-facing
# narrative (AiExplainer/AiEvaluationService). Optional: the feature degrades gracefully and the
# app runs fine if these are left blank.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# httpSMS (https://httpsms.com). Optional: SmsAlerts marks deliveries FAILED with
# "SMS not configured" if left blank.
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=
